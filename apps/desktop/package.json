{
  "name": "@reina/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "../../dist/apps/desktop/main.js",
  "scripts": {
    "build": "tsup && npm run build:renderer-react",
    "build:renderer-react": "vite build --config vite.renderer.config.ts && node scripts/copy-legacy-chat-assets.cjs",
    "dev:renderer-react": "node scripts/copy-legacy-chat-assets.cjs && vite build --watch --config vite.renderer.config.ts",
    "typecheck:renderer-react": "tsc -p src/renderer-react/tsconfig.json",
    "dev": "node scripts/dev.cjs",
    "rebuild-native": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@iconify-json/vscode-icons": "^1.2.57",
    "@iconify/react": "^6.0.2",
    "@reina/desktop-protocol": "0.1.0",
    "@reina/protocol": "0.1.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "shiki-stream": "^0.1.4",
    "vscode-icons-js": "^11.6.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^39.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
